# 单机部署；域名仅为示例，部署前替换所有占位值。
# 复制为 .env 后，只需改：DOMAIN、PUBLIC_BASE_URL、DJANGO_ALLOWED_HOSTS、DJANGO_CSRF_TRUSTED_ORIGINS（都填你的域名），
# 以及 DJANGO_SECRET_KEY、DB_PASSWORD、DB_ADMIN_PASSWORD（各自填随机值，可用 openssl rand -base64 48 生成）。
# 下一行让 docker compose 自动同时使用 compose.yaml 和 compose.prod.yaml，命令里不用再写 -f。
COMPOSE_FILE=compose.yaml:compose.prod.yaml
APP_ENV=production
DOMAIN=weekly.example.com
PUBLIC_BASE_URL=https://weekly.example.com
DJANGO_ALLOWED_HOSTS=weekly.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://weekly.example.com
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DB_HOST=db
DB_PORT=5432
DB_NAME=weekly_reports
DB_USER=weekly_app
DB_PASSWORD=replace-with-random-app-database-password
DB_ADMIN_PASSWORD=replace-with-different-random-maintenance-password
# 邮件总开关：false 时不发任何邮件，催交入口隐藏（2026-11-16 起默认关闭）
EMAIL_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-approved-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=replace-with-dedicated-mailbox
EMAIL_HOST_PASSWORD=replace-with-smtp-credential
DEFAULT_FROM_EMAIL=weekly@example.invalid
BACKUP_DIR=/backups
