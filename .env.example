APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DB_HOST=db
DB_PORT=5432
DB_NAME=weekly_reports
DB_USER=weekly_app
DB_PASSWORD=replace-with-a-random-database-password
DB_ADMIN_PASSWORD=replace-with-a-different-database-maintenance-password
# 邮件总开关：false 时不发任何邮件，催交入口隐藏（2026-11-16 起默认关闭）
EMAIL_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=weekly@example.invalid
DOMAIN=weekly.example.invalid
BACKUP_DIR=/backups
